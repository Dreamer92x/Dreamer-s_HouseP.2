<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Второй этап</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #ffffff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Determination Mono', 'Press Start 2P', 'Courier New', monospace;
            transition: background 0.8s ease;
            padding: 20px;
        }
        body.dark {
            background: #111111;
        }
        .container {
            max-width: 800px;
            width: 100%;
            text-align: center;
            transition: all 0.5s ease;
        }
        .input-area {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
        }
        .input-area input {
            font-family: 'Determination Mono', 'Press Start 2P', monospace;
            font-size: 32px;
            padding: 15px 25px;
            border: 3px solid #000000;
            background: #ffffff;
            color: #000000;
            text-align: center;
            width: 300px;
            max-width: 90%;
            outline: none;
            transition: 0.3s;
            letter-spacing: 4px;
            text-transform: uppercase;
        }
        .input-area input:focus {
            border-color: #666666;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
        }
        .input-area .hint {
            font-size: 14px;
            color: #666666;
            opacity: 0.6;
            letter-spacing: 2px;
        }
        .hidden {
            display: none !important;
        }
        .choice-area {
            margin-top: 30px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
        }
        .choice-area p {
            color: #ffffff;
            font-size: 24px;
            letter-spacing: 3px;
            text-shadow: 0 0 10px rgba(255,255,255,0.3);
        }
        .choice-buttons {
            display: flex;
            gap: 40px;
            flex-wrap: wrap;
            justify-content: center;
        }
        .choice-buttons button {
            font-family: 'Determination Mono', 'Press Start 2P', monospace;
            font-size: 20px;
            padding: 18px 40px;
            border: 2px solid #ffffff;
            background: transparent;
            color: #ffffff;
            cursor: pointer;
            transition: 0.3s;
            letter-spacing: 2px;
        }
        .choice-buttons button:hover {
            background: #ffffff;
            color: #000000;
        }
        .bsod {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #0000aa;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px;
            z-index: 999;
            font-family: 'Determination Mono', 'Courier New', monospace;
            color: #ffffff;
            animation: bsodFlicker 0.5s ease;
        }
        .bsod.active {
            display: flex;
        }
        @keyframes bsodFlicker {
            0% { opacity: 0; transform: scale(0.95); }
            20% { opacity: 1; transform: scale(1.02); }
            40% { opacity: 0.8; }
            60% { opacity: 1; }
            100% { opacity: 1; transform: scale(1); }
        }
        .bsod-content {
            max-width: 800px;
            width: 100%;
            text-align: left;
            font-size: 18px;
            line-height: 1.8;
            background: rgba(0,0,170,0.9);
            padding: 30px;
            border: 2px solid #ffffff;
            box-shadow: 0 0 50px rgba(0,0,255,0.5);
        }
        .bsod-content .title {
            font-size: 28px;
            font-weight: bold;
            text-align: center;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 3px;
        }
        .bsod-content .error-code {
            font-size: 14px;
            color: #aaccff;
            margin: 10px 0;
        }
        .bsod-content .progress {
            background: #ffffff;
            height: 4px;
            width: 100%;
            margin: 15px 0;
            animation: bsodProgress 55s linear forwards;
        }
        @keyframes bsodProgress {
            0% { width: 0%; }
            100% { width: 100%; }
        }
        .bsod-content .footer {
            margin-top: 20px;
            font-size: 14px;
            color: #88aaff;
            text-align: center;
        }
        .linux-penguin {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #000000;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 999;
            font-family: 'Determination Mono', 'Courier New', monospace;
            color: #00ff00;
            padding: 20px;
        }
        .linux-penguin.active {
            display: flex;
        }
        .linux-penguin pre {
            font-size: 14px;
            line-height: 1.2;
            color: #00ff00;
            text-shadow: 0 0 10px rgba(0,255,0,0.3);
            white-space: pre-wrap;
            word-break: break-all;
            max-width: 100%;
            background: #000000;
            padding: 20px;
            border: 1px solid #00ff00;
        }
        .linux-penguin .boot-text {
            font-size: 18px;
            margin-top: 20px;
            letter-spacing: 2px;
            animation: blink 1s step-end infinite;
        }
        @keyframes blink {
            50% { opacity: 0; }
        }
        .final-message {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.9);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            font-family: 'Determination Mono', 'Courier New', monospace;
            color: #ffffff;
            text-align: center;
            padding: 20px;
            flex-direction: column;
            gap: 20px;
        }
        .final-message.active {
            display: flex;
        }
        .final-message h1 {
            font-size: 36px;
            letter-spacing: 4px;
            text-shadow: 0 0 30px rgba(255,255,255,0.5);
        }
        .final-message p {
            font-size: 20px;
            max-width: 600px;
            line-height: 1.6;
            opacity: 0.8;
        }
        @media (max-width: 700px) {
            .input-area input { font-size: 24px; width: 90%; }
            .choice-buttons button { font-size: 16px; padding: 14px 28px; }
            .bsod-content { font-size: 14px; padding: 20px; }
            .bsod-content .title { font-size: 20px; }
            .linux-penguin pre { font-size: 10px; }
            .final-message h1 { font-size: 26px; }
            .final-message p { font-size: 16px; }
        }
        @media (max-width: 480px) {
            .input-area input { font-size: 18px; padding: 10px 15px; }
            .choice-buttons button { font-size: 14px; padding: 10px 20px; }
            .bsod-content { font-size: 12px; padding: 15px; }
            .bsod-content .title { font-size: 16px; }
            .linux-penguin pre { font-size: 8px; }
            .final-message h1 { font-size: 20px; }
            .final-message p { font-size: 14px; }
        }
    </style>
</head>
<body>
    <div class="container" id="mainContainer">
        <div class="input-area" id="inputArea">
            <input type="text" id="bugInput" placeholder="ВВЕДИТЕ КОД" maxlength="10" autofocus>
            <div class="hint">Введите BUG для продолжения</div>
        </div>
        <div class="choice-area hidden" id="choiceArea">
            <p>С какого вы устройства?</p>
            <div class="choice-buttons">
                <button id="pcChoice">💻 Компьютер</button>
                <button id="phoneChoice">📱 Телефон</button>
            </div>
        </div>
    </div>

    <div class="bsod" id="bsod">
        <div class="bsod-content">
            <div class="title">💀 СИНИЙ ЭКРАН СМЕРТИ</div>
            <div class="error-code">STOP: 0x0000007B (0xFFFFF88001234567, 0x0000000000000000, 0x0000000000000000)</div>
            <div class="error-code">SYSTEM_SERVICE_EXCEPTION</div>
            <div style="margin: 15px 0; font-size: 16px;">Windows загружает критически важные драйверы...</div>
            <div class="progress"></div>
            <div style="font-size: 15px; color: #88aaff;">Идёт сброс дампа памяти: <span id="dumpProgress">0</span>%</div>
            <div class="footer">Перезагрузите компьютер. Если проблема повторяется, обратитесь к администратору.</div>
        </div>
    </div>

    <div class="linux-penguin" id="linuxPenguin">
        <pre>
            .--.
           |o_o |
           |:_/ |
          //   \ \
         (|     | )
        /'\_   _/`\
        \___)=(___/
        </pre>
        <div class="boot-text">Загрузка Linux kernel... 5.15.0-86-generic</div>
        <div style="font-size: 14px; color: #00ff00; margin-top: 10px; opacity: 0.7;">Инициализация ядра... OK</div>
        <div style="font-size: 14px; color: #00ff00; margin-top: 5px; opacity: 0.7;">Монтирование корневой ФС... OK</div>
        <div style="font-size: 14px; color: #00ff00; margin-top: 5px; opacity: 0.7;">Запуск systemd... OK</div>
        <div style="font-size: 14px; color: #00ff00; margin-top: 5px; opacity: 0.7; animation: blink 1s step-end infinite;">Готово. Вход в систему...</div>
    </div>

    <div class="final-message" id="finalMessage">
        <h1>✅ Пройден 2 этап</h1>
        <p>Есть какие нибудь вопросы?</p>
    </div>

    <script>
        const bugInput = document.getElementById('bugInput');
        const inputArea = document.getElementById('inputArea');
        const choiceArea = document.getElementById('choiceArea');
        const mainContainer = document.getElementById('mainContainer');
        const bsod = document.getElementById('bsod');
        const linuxPenguin = document.getElementById('linuxPenguin');
        const finalMessage = document.getElementById('finalMessage');
        const dumpProgress = document.getElementById('dumpProgress');

        let timer = null;
        let isCompleted = false;

        function checkBug() {
            const val = bugInput.value.trim().toLowerCase();
            if (val === 'bug' && !isCompleted) {
                isCompleted = true;
                document.body.classList.add('dark');
                inputArea.classList.add('hidden');
                choiceArea.classList.remove('hidden');
                bugInput.blur();
            }
        }

        bugInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') checkBug();
        });

        bugInput.addEventListener('input', function() {
            if (this.value.length > 0) checkBug();
        });

        function startTimer() {
            let seconds = 0;
            const maxSeconds = 55;
            if (dumpProgress) {
                dumpProgress.textContent = '0';
                const interval = setInterval(() => {
                    seconds++;
                    const progress = Math.min(Math.round((seconds / maxSeconds) * 100), 100);
                    if (dumpProgress) dumpProgress.textContent = progress;
                    if (seconds >= maxSeconds) {
                        clearInterval(interval);
                        if (!finalMessage.classList.contains('active')) {
                            finalMessage.classList.add('active');
                            bsod.classList.remove('active');
                            linuxPenguin.classList.remove('active');
                        }
                    }
                }, 1000);
            } else {
                setTimeout(() => {
                    if (!finalMessage.classList.contains('active')) {
                        finalMessage.classList.add('active');
                        bsod.classList.remove('active');
                        linuxPenguin.classList.remove('active');
                    }
                }, maxSeconds * 1000);
            }
        }

        document.getElementById('pcChoice').addEventListener('click', function() {
            if (isCompleted) {
                bsod.classList.add('active');
                choiceArea.classList.add('hidden');
                startTimer();
            }
        });

        document.getElementById('phoneChoice').addEventListener('click', function() {
            if (isCompleted) {
                linuxPenguin.classList.add('active');
                choiceArea.classList.add('hidden');
                startTimer();
            }
        });

        // Фокус на поле ввода
        window.addEventListener('load', function() {
            bugInput.focus();
        });
    </script>
</body>
</html>
